# Groq API key for the chat assistant (https://console.groq.com/keys).
# Without it the dashboards and forms still work; only the assistant is disabled.
GROQ_API_KEY=

# Groq model with tool-calling support.
HR_MODEL=openai/gpt-oss-120b

# SQLite file, relative to the project root unless absolute.
HR_DB_PATH=data/hr.db

# Load the sample company into an empty database.
HR_SEED_DEMO_DATA=true

# Leave rules.
HR_ANNUAL_LEAVE_DAYS=20
# Warn when this many teammates already have approved leave in the same period.
HR_COVERAGE_THRESHOLD=2

LOG_LEVEL=INFO

# Identity used by the MCP server (python -m hr_assistant.mcp_server).
HR_MCP_USER=Aditi Sharma
HR_MCP_ROLE=Employee
